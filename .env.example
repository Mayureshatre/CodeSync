# PostgreSQL Connection String (Transaction pooled for Vercel/Serverless)
DATABASE_URL="postgresql://user:password@localhost:5432/codesync?pgbouncer=true"
# Direct PostgreSQL Connection String (Used for Prisma migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/codesync"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Storage
# AWS S3 or Cloudflare R2 compatible
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_PRIVATE="codesync-resumes"
S3_BUCKET_PUBLIC="codesync-public"
S3_REGION="us-east-1"
# Required for non-AWS S3 compatible providers (e.g., Cloudflare R2, MinIO, DigitalOcean)
S3_ENDPOINT=""

# Realtime
ABLY_API_KEY="your-ably-api-key-here"

# Email Configuration (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="CodeSync <noreply@yourdomain.com>"

# Observability
SENTRY_DSN=""
POSTHOG_API_KEY=""
