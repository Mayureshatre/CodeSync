{
  "name": "codesync",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "corepack pnpm -r run build",
    "dev": "corepack pnpm --parallel -r run dev",
    "lint": "corepack pnpm -r run lint",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "artillery": "^2.0.34",
    "jsdom": "^30.0.1",
    "prisma": "5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver",
      "workerd"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ts-node": "^10.9.2"
